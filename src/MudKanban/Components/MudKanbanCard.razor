@using MudBlazor
@using KanbanCardModel = MudKanban.Models.KanbanCard

<div class="mud-kanban-card"
     draggable="true"
     @ondragstart="HandleDragStart"
     @ondragover:preventDefault="true">
    @if (CardTemplate is not null)
    {
        @CardTemplate(Card)
    }
    else
    {
        <MudCard Elevation="2" Class="@CardClass">
            <MudCardContent Class="pa-2">
                <MudText Typo="Typo.subtitle2" Class="mud-text-truncate">@Card.Title</MudText>
                @if (!string.IsNullOrEmpty(Card.Description))
                {
                    <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">@Card.Description</MudText>
                }
                <div class="d-flex align-center gap-2 mt-2">
                    @if (!string.IsNullOrEmpty(Card.Assignee))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default"
                                 Icon="@Icons.Material.Filled.Person">@Card.Assignee</MudChip>
                    }
                    @if (Card.DueDate.HasValue)
                    {
                        var overdue = Card.DueDate.Value < DateTime.Today;
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(overdue ? Color.Error : Color.Default)"
                                 Icon="@Icons.Material.Filled.CalendarToday">
                            @Card.DueDate.Value.ToString("MMM d")
                        </MudChip>
                    }
                </div>
            </MudCardContent>
        </MudCard>
    }
</div>

@code {
    [Parameter, EditorRequired] public KanbanCardModel Card { get; set; } = default!;
    [Parameter] public RenderFragment<KanbanCardModel>? CardTemplate { get; set; }
    [Parameter] public EventCallback<KanbanCardModel> OnDragStart { get; set; }

    private string CardClass =>
        $"mud-kanban-card-inner border-l-4 border-{Card.Color}";

    private async Task HandleDragStart()
    {
        await OnDragStart.InvokeAsync(Card);
    }
}
