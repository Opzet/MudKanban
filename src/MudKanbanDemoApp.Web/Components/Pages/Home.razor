@page "/"
@rendermode InteractiveServer
@using KanbanCardModel = MudKanban.Models.KanbanCard
@using KanbanCardMovedEventArgsModel = MudKanban.Models.KanbanCardMovedEventArgs
@using KanbanColumnModel = MudKanban.Models.KanbanColumn

<PageTitle>MudKanban Demo</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">MudKanban Demo</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Drag and drop cards between columns. WIP limits are enforced per column.
</MudText>

<MudKanbanBoard Columns="@_columns"
                @bind-Cards="@_cards"
                OnCardMoved="@OnCardMoved" />

@if (_lastEvent is not null)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">@_lastEvent</MudAlert>
}

@code {
    private string? _lastEvent;

    private readonly KanbanColumnModel _backlog = new() { Title = "Backlog", Order = 0 };
    private readonly KanbanColumnModel _todo = new() { Title = "To Do", Order = 1, WipLimit = 3 };
    private readonly KanbanColumnModel _inProgress = new() { Title = "In Progress", Order = 2, WipLimit = 2 };
    private readonly KanbanColumnModel _review = new() { Title = "Review", Order = 3, WipLimit = 2 };
    private readonly KanbanColumnModel _done = new() { Title = "Done", Order = 4 };

    private IReadOnlyList<KanbanColumnModel> _columns = [];
    private IReadOnlyList<KanbanCardModel> _cards = [];

    protected override void OnInitialized()
    {
        _columns = [_backlog, _todo, _inProgress, _review, _done];
        _cards =
        [
            new KanbanCardModel { Title = "Design system setup",   ColumnId = _done.Id,       Order = 0, Color = "default" },
            new KanbanCardModel { Title = "API integration",       ColumnId = _inProgress.Id, Order = 0, Color = "warning", Assignee = "Alice", DueDate = DateTime.Today.AddDays(2) },
            new KanbanCardModel { Title = "Write unit tests",      ColumnId = _todo.Id,       Order = 0, Color = "info", Assignee = "Bob" },
            new KanbanCardModel { Title = "Fix login bug",         ColumnId = _review.Id,     Order = 0, Color = "error", DueDate = DateTime.Today.AddDays(-1) },
            new KanbanCardModel { Title = "Accessibility audit",   ColumnId = _backlog.Id,    Order = 0, Color = "secondary" },
            new KanbanCardModel { Title = "Performance profiling", ColumnId = _backlog.Id,    Order = 1, Color = "default" },
            new KanbanCardModel { Title = "Release notes",         ColumnId = _todo.Id,       Order = 1, Color = "success" },
        ];
    }

    private void OnCardMoved(KanbanCardMovedEventArgsModel args)
    {
        _lastEvent = $"Card {args.CardId} moved from {args.SourceColumnId} to {args.TargetColumnId} at index {args.NewIndex}.";
    }
}
